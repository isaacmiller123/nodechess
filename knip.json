{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/web/main.web.tsx",
    "src/seed/main.tsx",
    "src/seed/electron-main.ts",
    "server/index.ts",
    "server/bridge-entry.ts",
    "scripts/test-*.mjs",
    "scripts/smoke-*.mjs",
    "scripts/build-*.mjs",
    "scripts/operator-*.mjs",
    "scripts/fetch-*.mjs",
    "scripts/gen-*.mjs",
    "scripts/verify-*.mjs",
    "scripts/validate-*.mjs",
    "scripts/check-*.mjs",
    "scripts/calibrate-weak.mjs",
    "scripts/demo-maia.mjs",
    "scripts/fit-elo-model.mjs",
    "scripts/patch-ffish-csp.mjs",
    "scripts/prep-chess3d.mjs",
    "scripts/probe-fairy-sf.mjs",
    "scripts/release.mjs",
    "scripts/run-python.mjs",
    "scripts/run-suites.mjs",
    "scripts/sim-bot-time.mjs",
    "scripts/smoke_engine.mjs",
    "electron.seed.config.ts",
    "vite.web.config.ts",
    "vite.seed.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "server/**/*.ts", "scripts/**/*.mjs"],
  "paths": {
    "@/*": ["src/renderer/src/*"],
    "@shared/*": ["src/shared/*"]
  },
  "ignoreDependencies": [".*"],
  "ignoreBinaries": [".*"],
  "includeEntryExports": true
}
